# -----------------------------------------------------------------------------
# Jobryn browser (publishable values only)
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
VITE_AUTH_GOOGLE_ENABLED=true
VITE_AUTH_GITHUB_ENABLED=true
VITE_AUTH_AZURE_ENABLED=true
VITE_AUTH_APPLE_ENABLED=false

# -----------------------------------------------------------------------------
# Jobryn server - NEVER expose these through VITE_ variables
# -----------------------------------------------------------------------------
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY

APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=1
NODE_ENV=development
PORT=3000

# Stripe Billing - Jobryn SaaS subscription payments
STRIPE_SECRET_KEY=rk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_PRICE_STARTER=price_REPLACE_ME
STRIPE_PRICE_GROWTH=price_REPLACE_ME
STRIPE_PRICE_OPERATOR=price_REPLACE_ME

# Require aal2 for checkout/portal in hardened deployments after owner MFA rollout.
REQUIRE_AAL2_SENSITIVE=false
REQUIRE_EMAIL_VERIFICATION=false

# Server-only AI key
GEMINI_API_KEY=MY_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.7-flash

# OpenAI powers receptionist conversation logic. Server only.
OPENAI_API_KEY=sk-proj_REPLACE_ME
OPENAI_MODEL=gpt-5-mini

# Twilio Messaging/Voice - server only. Use E.164 format, for example +61412345678.
TWILIO_ACCOUNT_SID=AC_REPLACE_ME
TWILIO_AUTH_TOKEN=REPLACE_ME
TWILIO_PHONE_NUMBER=+61_REPLACE_ME
